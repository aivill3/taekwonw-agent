{
  "_comment": "원본 유실로 다시 작성한 판본입니다. 각 규칙의 patterns 중 하나라도 '줄'에 걸리면 그 줄 전체가 본문에서 제외됩니다. 감정 분석과 형태소 통계가 캡션·출처 문구에 오염되는 것을 막는 용도이며, 발행 원고 자체를 고치지는 않습니다.",
  "rules": {
    "photo_caption": {
      "description": "사진 캡션. '사진=', '제공=', '▲' 로 시작하거나 '모습/장면.' 으로 명사형 종결하는 짧은 줄.",
      "patterns": [
        "^\\s*[▲△▶■□◆]",
        "사진\\s*[=:]",
        "제공\\s*[=:]",
        "촬영\\s*[=:]",
        "^.{0,100}(?:모습|장면)\\s*\\.?\\s*$"
      ]
    },
    "byline": {
      "description": "기자 서명. 줄 전체가 이름+기자 형태이거나 대괄호·꺾쇠로 감싼 경우.",
      "patterns": [
        "^\\s*(?:[가-힣A-Za-z]+\\s*=\\s*)?[가-힣]{2,4}\\s*(?:기자|특파원|인턴기자)\\s*$",
        "\\[[^\\[\\]]{0,30}(?:기자|특파원)[^\\[\\]]{0,30}\\]",
        "<[^<>]{0,30}(?:기자|특파원)[^<>]{0,10}>"
      ]
    },
    "copyright": {
      "description": "저작권·재배포 안내.",
      "patterns": [
        "무단\\s*전재",
        "재배포\\s*금지",
        "저작권자",
        "[ⓒ©]",
        "(?i)copyright",
        "all\\s+rights\\s+reserved"
      ]
    },
    "contact": {
      "description": "이메일·전화·제보 안내.",
      "patterns": [
        "[\\w.\\-]+@[\\w.\\-]+\\.\\w+",
        "제보\\s*[:=]",
        "카카오톡\\s*[:=]",
        "^\\s*[▶▷►☞]\\s*(?:제보|구독|앱|네이버)"
      ]
    },
    "related_links": {
      "description": "관련기사·추천기사 목록 줄.",
      "patterns": [
        "^\\s*(?:관련\\s*기사|연관\\s*기사|추천\\s*기사|많이\\s*본\\s*뉴스|인기\\s*기사|주요\\s*뉴스)\\s*$",
        "^\\s*(?:\\[관련\\]|<관련>)"
      ]
    },
    "agency_prefix": {
      "description": "통신사 캡션 줄. '(지역=매체) 이름 기자 = 설명. 2026.8.14' 형태로 날짜로 끝나는 것만.",
      "patterns": [
        "^\\s*\\([^()]{1,30}=[^()]{1,30}\\)\\s*[가-힣]{2,4}\\s*(?:기자|특파원)\\s*=.*\\d{4}\\s*\\.\\s*\\d{1,2}\\s*\\.\\s*\\d{1,2}\\s*\\.?\\s*$"
      ]
    },
    "cta": {
      "description": "발행 시 붙는 고정 안내 문구. 품질 측정 대상이 아니다. 실제 문구는 prompts/draft/cta.txt 에서 자동으로 읽어 규칙을 만드므로(boilerplate_filter._cta_patterns), 여기에 옮겨 적지 않는다. 아래는 CTA 를 바꿔도 남을 만한 보조 패턴만 둔다.",
      "patterns": [
        "^\\s*[⬇↓▼]\\s*$"
      ]
    }
  }
}