# 이 파일을 .env 로 복사해 값을 채우세요.
#   copy .env.example .env
#
# 코드가 실제로 읽는 환경변수를 전수 조사해 만든 목록입니다.
# 값이 없어도 되는 항목은 기본값을 주석으로 적었습니다.

# ── 필수: API 자격증명 ────────────────────────────────
# 네이버 개발자센터 > 애플리케이션 > 검색 API
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google AI Studio > API keys
GEMINI_API_KEY=

# Notion > 설정 > 연결 > 통합 만들기
# 만든 통합을 대상 데이터베이스에 '연결(공유)' 해야 합니다.
NOTION_API_KEY=
# 데이터베이스 URL 의 32자리 hex 부분
NOTION_DATABASE_ID=


# ── 선택: 알림 ────────────────────────────────────────
# 비워 두면 Slack 알림을 건너뜁니다 (파이프라인은 정상 동작).
# 잠깐 끄고 싶으면 이 줄 앞에 # 을 붙이세요.
SLACK_WEBHOOK_URL=


# ── 수집 ──────────────────────────────────────────────
# 수집 대상 기간(일). 직전 실행 이후만 보면 창이 좁아 며칠에 걸친
# 보도를 놓칩니다. 이미 처리한 기사는 processed_urls 가 걸러냅니다.
# LOOKBACK_DAYS=3


# ── 선정 (당일 기준) ──────────────────────────────────
# 소주제를 만들 기사를 당일 발행분으로 제한할지. 0 이면 수집분 전체.
# SELECT_TODAY_ONLY=1

# '당일'의 정의
#   calendar : KST 오늘 00:00 이후
#   24h      : 실행 시각 기준 최근 TODAY_WINDOW_HOURS 시간
# 국내 언론은 오전 9시 이후에 기사가 몰립니다. 오전에 실행한다면
# calendar 는 후보가 거의 남지 않으므로 24h 를 검토하세요.
# TODAY_MODE=calendar
# TODAY_WINDOW_HOURS=24

# 후보가 이 수에 못 미치면 시간창을 아래 단계로 넓힙니다.
# TODAY_FALLBACK_HOURS 를 비우면 자동 확대를 끕니다(엄격한 당일 제한).
# TODAY_MIN_CANDIDATES=3
# TODAY_FALLBACK_HOURS=24,48

# 발행일을 읽지 못한 기사를 당일로 볼지. 기본은 제외입니다.
# TODAY_ALLOW_UNKNOWN_DATE=0


# ── 모델 ──────────────────────────────────────────────
# 소주제 생성용 (호출이 잦아 RPD 넉넉한 lite 계열)
# GEMINI_MODEL=gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=

# 초안 작성용 (긴 원문 파악·표현력이 중요해 flash 계열)
# GEMINI_WRITER_MODEL=gemini-flash-latest
# GEMINI_WRITER_FALLBACK_MODELS=

# 한 번에 묶어 처리할 소주제 생성 건수
# SUBTOPIC_BATCH_SIZE=3

# API 버전
# GEMINI_API_VERSION=v1beta


# ── 삽화 ──────────────────────────────────────────────
# local  : 로컬 diffusers (할당량 없음, CPU 에서 장당 30~90초)
# gemini : Gemini 이미지 모델 (빠르지만 일일 한도 있음)
# IMAGE_SOURCE=local

# CPU 에서는 모델 선택이 곧 실행 시간입니다.
#   stabilityai/sd-turbo                      CPU 30~90초/장
#   runwayml/stable-diffusion-v1-5            CPU 2~5분/장
#   stabilityai/stable-diffusion-xl-base-1.0  CPU 5~10분/장
# DIFFUSERS_MODEL=stabilityai/sd-turbo
# DIFFUSERS_STEPS=4
# DIFFUSERS_WIDTH=768
# DIFFUSERS_HEIGHT=576
# turbo/lightning/lcm 계열은 코드가 0.0 을 강제합니다.
# DIFFUSERS_GUIDANCE=7.0

# `run.py images` 가 대상으로 삼을 초안의 최대 나이(일). 0 이면 전체.
# IMAGE_MAX_AGE_DAYS=1


# ── Notion 보관 정책 ──────────────────────────────────
# 작성완료(블로그 원고 보유) 페이지를 보존할지
# KEEP_WRITTEN=true
# WRITTEN_RETENTION_DAYS=30
